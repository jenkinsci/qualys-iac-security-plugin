<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:st="jelly:stapler" xmlns:d="jelly:define" xmlns:l="/lib/layout" xmlns:t="/lib/hudson" xmlns:f="/lib/form">
    <script src="${resURL}/plugin/qualys-iac-security/js/common.js?v=${descriptor.getUUID()}"></script>
    <div id="qualys-configuration-body" onmouseover="setPageStateValue()">
        <f:section title="Qualys IaC Scan">
            <div id="add-qualys-configuration">
                <f:repeatable var="inst" items="${instance.qualysApiConfigurations}" add="Add">
                        <input type="hidden" class="isPageLoad" name="_.isPageLoad" value="true"/>
                        <f:entry field="name" title="Name" class="required">
                            <f:textbox  checkMethod="post" value="${inst.name}" onmouseover="triggerValidation(event)"/>
                        </f:entry>
                        <f:entry field="qualysPlatformURL" title="Qualys Platform URL" class="required">
                            <f:textbox checkMethod="post" value="${inst.qualysPlatformURL}" onmouseover="triggerValidation(event)"/>
                        </f:entry>

                    <f:entry title="Authentication Type" field="authType">
                        <select class="auth-type-select" name="_.authType">
                            <j:choose>
                                <j:when test="${inst.authType == 'OIDC'}">
                                    <option value="OIDC" selected="selected">IDP</option>
                                    <option value="OAUTH">OAuth</option>
                                    <option value="Basic">Basic</option>
                                </j:when>
                                <j:when test="${inst.authType == 'OAUTH'}">
                                    <option value="OAUTH" selected="selected">OAuth</option>
                                    <option value="OIDC">IDP</option>
                                    <option value="Basic">Basic</option>
                                </j:when>
                                <j:otherwise>
                                    <option value="Basic" selected="selected">Basic</option>
                                    <option value="OAUTH">OAuth</option>
                                    <option value="OIDC">IDP</option>
                                </j:otherwise>
                            </j:choose>
                        </select>
                    </f:entry>


                    <f:entry field="qualysUserName" title="Username" class="required basic-auth-field">
                        <f:textbox checkMethod="post" value="${inst.qualysUserName}" onmouseover="triggerValidation(event)"/>
                    </f:entry>

                    <f:entry field="qualysPassword" title="Password" class="required basic-auth-field">
                        <f:password checkMethod="post" value="${inst.qualysPassword}" onmouseover="triggerValidation(event)"/>
                    </f:entry>

                    <f:entry field="tokenUrl" title="Token URL" class="oidc-auth-field">
                        <f:textbox checkMethod="post" value="${inst.tokenUrl}" onmouseover="triggerValidation(event)"/>
                    </f:entry>

                    <f:entry field="scope" title="Scope" class="oidc-auth-field">
                        <f:textbox checkMethod="post" value="${inst.scope}" onmouseover="triggerValidation(event)"/>
                    </f:entry>

                    <f:entry field="audience" title="Audience" class="oidc-auth-field">
                        <f:textbox checkMethod="post" value="${inst.audience}" onmouseover="triggerValidation(event)"/>
                    </f:entry>
                    <f:validateButton
                            title="Test Connection" progress="Testing..."
                            method="testConnection" with="qualysPlatformURL,authType,qualysUserName,qualysPassword,tokenUrl,scope,audience"/>
                        <f:entry title="">
                            <div align="right">
                                <f:repeatableDeleteButton value="Delete" />
                            </div>
                        </f:entry>
                </f:repeatable>
            </div>
            <br/>
        </f:section>
    </div>
</j:jelly>
